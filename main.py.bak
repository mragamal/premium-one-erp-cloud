app.include_router(customer_invoices_router)
app.include_router(vendor_bills_router)
app.include_router(journal_router)
app.include_router(fixed_assets_router)

if fixed_asset_statement_router:
    app.include_router(fixed_asset_statement_router)
if cost_centers_router:
    app.include_router(cost_centers_router)
if reports_router:
    app.include_router(reports_router)
if petty_cash_router:
    app.include_router(petty_cash_router)
if petty_cash_list_router:
    app.include_router(petty_cash_list_router)
if petty_cash_statement_router:
    app.include_router(petty_cash_statement_router)
if employees_router:
    app.include_router(employees_router)
